# Never commit real values. Configure production in the linked Vercel project.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CONTENT_ONLINE_ADMIN_EMAIL=
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna
# Optional migration fallback for KTH. New customer agents are configured per tenant in admin.
# Restrict every D-ID client key to the customer's exact origin. Never expose a D-ID API key.
DID_AGENT_ID=v2_agt_4xrfqG8W
DID_CLIENT_KEY=
# Shared customer-domain configuration. Only the automation token is secret.
CUSTOMER_PORTAL_ROOT_DOMAIN=portal.contentonline.se
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_AUTOMATION_TOKEN=
CRON_SECRET=

# Salesforce External Client App. All variables are server-only; never use NEXT_PUBLIC_.
# Salesforce requires HTTPS callbacks. Use a Vercel Preview or HTTPS tunnel for browser OAuth locally.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=https://content-online-platform.vercel.app/admin/api/salesforce/oauth/callback
SALESFORCE_API_VERSION=v67.0
# Separate random secrets: one signs short-lived OAuth state, one encrypts stored refresh tokens.
SALESFORCE_OAUTH_STATE_SECRET=
SALESFORCE_TOKEN_ENCRYPTION_KEY=
