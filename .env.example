# Never commit real values. Configure production in the linked Vercel project.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CONTENT_ONLINE_ADMIN_EMAIL=
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna
# Shared D-ID default for agent-enabled customer portals. A complete per-tenant override is optional.
# Restrict this client key to the shared portal origin. Add an exact custom origin before using it there.
# Never expose or enter a D-ID API key as browser configuration.
DID_AGENT_ID=v2_agt_4xrfqG8W
DID_CLIENT_KEY=
# Shared customer-domain configuration. The verified wildcard needs no per-customer token.
CUSTOMER_PORTAL_ROOT_DOMAIN=portal.contentonline.se
CUSTOMER_PORTAL_WILDCARD_READY=false
# Optional only for individually managed custom domains. IDs must target `content-online-platform`.
CUSTOMER_PORTAL_VERCEL_PROJECT_ID=
CUSTOMER_PORTAL_VERCEL_TEAM_ID=
VERCEL_AUTOMATION_TOKEN=

# Salesforce External Client App. All variables are server-only; never use NEXT_PUBLIC_.
# Salesforce requires HTTPS callbacks. Use a Vercel Preview or HTTPS tunnel for browser OAuth locally.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=https://content-online-platform.vercel.app/admin/api/salesforce/oauth/callback
SALESFORCE_API_VERSION=v67.0
# Separate random secrets: one signs short-lived OAuth state, one encrypts stored refresh tokens.
SALESFORCE_OAUTH_STATE_SECRET=
SALESFORCE_TOKEN_ENCRYPTION_KEY=
